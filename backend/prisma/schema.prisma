generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ASSOCIATE
  ADMIN
}

enum AppointmentStatus {
  PENDING_PAYMENT
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE // Razorpay
  DESK   // cash or UPI collected at the clinic desk (walk-ins)
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClinicDayStatus {
  OPEN
  PAUSED
  CLOSED
}

// How a family member is related to the account holder who manages them.
enum FamilyRelationship {
  PARENT
  CHILD
  SPOUSE
  OTHER
}

enum WaitlistStatus {
  WAITING // in line
  OFFERED // has a pending offer (one at a time)
  CLAIMED // took an offered slot: done
  LEFT    // left the waitlist, or their data was deleted
  EXPIRED // the date passed
}

enum WaitlistOfferStatus {
  PENDING   // held for this person for 10 minutes
  CLAIMED
  DECLINED
  EXPIRED
  WITHDRAWN // they left the waitlist, or the slot can no longer be offered
}

enum NotificationChannel {
  SMS
  PUSH
}

enum NotificationType {
  BOOKING_CONFIRMED
  REMINDER
  QUEUE_UPDATE
  CANCELLED
  REFUND_ISSUED
  SLOTS_AVAILABLE
  LEAVE_NOW
  WAITLIST_OFFER
}

enum NotificationStatus {
  PENDING // claimed, SMS being sent
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  passwordHash String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  patient    Patient?
  admin      Admin?
  doctor     Doctor?
  associate  Associate?
  auditLogs  AuditLog[]      @relation("ActorAuditLogs")
  notifications Notification[]
}

// A patient is an account holder (has a login: userId set), a family member
// managed by one (accountHolderId set, no login of their own), or a separate
// walk-in record (walkInPhone set). Exactly one of the three.
// Family members have their own name and visit history; their messages go
// to the account holder's phone.
model Patient {
  id            String   @id @default(uuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  accountHolderId String?
  accountHolder   Patient?            @relation("Family", fields: [accountHolderId], references: [id])
  familyMembers   Patient[]           @relation("Family")
  relationship    FamilyRelationship?
  dateOfBirth     String? // yyyy-mm-dd, optional
  ageYears        Int?    // when only an age was given...
  ageRecordedOn   String? // ...and the day (yyyy-mm-dd) it was given
  // A walk-in the desk added with a number that belongs to someone else's
  // account, without that account holder confirming: a separate record that
  // keeps only the number given and is never linked to the account.
  walkInPhone     String?
  fullName      String?
  address       String?
  idDocumentRef String?
  consentAt     DateTime?
  // "app" (patient ticked the box), "desk" (told the associate, for walk-ins),
  // "guardian" (the account holder consented for a child under 18) or
  // "account-holder" (the account holder confirmed an adult member agreed).
  consentSource String?
  deletedAt     DateTime? // DPDP erasure: personal fields cleared, visit and payment records kept anonymously
  createdAt     DateTime @default(now())

  appointments Appointment[]
  slotAlerts   SlotAlert[]
  notifications Notification[]
  waitlistEntries WaitlistEntry[]

  @@index([accountHolderId])
}

// "Notify me when slots open" for a doctor with no free slots.
model SlotAlert {
  id         String    @id @default(uuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     Doctor    @relation(fields: [doctorId], references: [id])
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // set once the patient has been told; a new request clears it

  @@unique([patientId, doctorId])
  @@index([doctorId, notifiedAt])
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String?
  createdAt DateTime @default(now())

  clinics Clinic[]
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  address   String?
  // Where the clinic is, for "Leave now" travel estimates. Clinics without
  // coordinates do not offer the feature.
  latitude  Float?
  longitude Float?
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())

  doctors    Doctor[]
  associates Associate[]
}

model Doctor {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  fullName         String
  specialization   String
  consultationFee  Int
  avgConsultMinutes Int     @default(15)
  bio              String?
  isActive         Boolean  @default(true)
  // Medical registration (NMC / state medical council), checked by the clinic admin.
  registrationNumber  String?
  registrationCouncil String?
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verifiedByUserId    String?
  rejectionReason     String?
  createdAt        DateTime @default(now())

  slots          Slot[]
  appointments   Appointment[]
  clinicDays     ClinicDay[]
  associateLinks AssociateDoctor[]
  slotAlerts     SlotAlert[]
  waitlistEntries WaitlistEntry[]
  displayLinks   DisplayLink[]
}

model Associate {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  createdAt DateTime @default(now())

  assignedDoctors AssociateDoctor[]
}

model AssociateDoctor {
  id          String    @id @default(uuid())
  associateId String
  associate   Associate @relation(fields: [associateId], references: [id])
  doctorId    String
  doctor      Doctor    @relation(fields: [doctorId], references: [id])

  @@unique([associateId, doctorId])
}

model Slot {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  slotDate  String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  appointments Appointment[]
  waitlistOffers WaitlistOffer[]

  @@index([doctorId, slotDate])
  @@unique([doctorId, startsAt])
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  slotId        String
  slot          Slot              @relation(fields: [slotId], references: [id])
  status        AppointmentStatus @default(PENDING_PAYMENT)
  isWalkIn      Boolean           @default(false)
  // "Leave now" alert (opt-in). Only the travel time is kept: the patient's
  // location is read once to compute it and never stored or logged.
  leaveAlertOptedInAt     DateTime?
  leaveAlertTravelMinutes Int?
  leaveAlertSource        String? // "estimate" (from location) or "manual" (patient typed it)
  leaveAlertSentAt        DateTime?
  queueToken    Int?
  queueDate     String?
  cancelledAt   DateTime?
  cancelReason  String?
  checkedInAt   DateTime?
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payment  Payment?
  qrToken  QrToken?

  @@index([doctorId, queueDate])
  @@index([slotId])
  // A slot is reused after a cancellation, so uniqueness only applies to
  // active appointments. Two partial unique indexes, written by hand in
  // migration 20261110090000_reusable_slots (Prisma cannot express them):
  //   one active appointment per slot, and one active holder per token.
  // If `prisma migrate dev` ever proposes dropping them, keep them.
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Int
  method        PaymentMethod @default(ONLINE)
  status        PaymentStatus @default(CREATED)
  gatewayRef     String?      @unique // Razorpay payment id (pay_...)
  gatewayOrderId String?      @unique // Razorpay order id (order_...)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  refund Refund?
}

model Refund {
  id         String       @id @default(uuid())
  paymentId  String       @unique
  payment    Payment      @relation(fields: [paymentId], references: [id])
  amount     Int
  status     RefundStatus @default(PENDING)
  gatewayRef String?
  createdAt  DateTime     @default(now())
}

model QrToken {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  token         String      @unique
  shortCode     String?     @unique // typed at the desk when the QR cannot be scanned
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  actor        User     @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action       String
  targetType   String
  targetId     String
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  // The patient the message is about (a family member's messages go to the
  // account holder's phone), so deleting that member removes them too.
  patientId String?
  patient   Patient?            @relation(fields: [patientId], references: [id])
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus
  payload   String?
  sentAt    DateTime            @default(now())
  // Set for messages that must go out at most once (reminders, "3rd in
  // line"): whoever inserts the key first sends; everyone else skips.
  dedupeKey String?             @unique
}

model ClinicDay {
  id         String          @id @default(uuid())
  doctorId   String
  doctor     Doctor          @relation(fields: [doctorId], references: [id])
  date       String
  status     ClinicDayStatus @default(OPEN)
  nowServing Int             @default(0)

  @@unique([doctorId, date])
}

// Waitlist for a doctor on a fully booked day. When a slot on that day is
// freed, it is offered to the first person waiting (join order), held for
// them for 10 minutes; they claim it and then pay as usual. Different from
// SlotAlert, which only texts when the doctor publishes new slots.
//
// Hand-written partial unique indexes (migration *_waitlist):
//   one live entry (WAITING or OFFERED) per patient, doctor and date;
//   one PENDING offer per slot.
model WaitlistEntry {
  id        String         @id @default(uuid())
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor         @relation(fields: [doctorId], references: [id])
  date      String // yyyy-mm-dd (IST)
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now()) // join order
  endedAt   DateTime?

  offers WaitlistOffer[]

  @@index([doctorId, date, status, createdAt])
  @@index([patientId])
}

model WaitlistOffer {
  id            String              @id @default(uuid())
  entryId       String
  entry         WaitlistEntry       @relation(fields: [entryId], references: [id])
  slotId        String
  slot          Slot                @relation(fields: [slotId], references: [id])
  status        WaitlistOfferStatus @default(PENDING)
  offeredAt     DateTime            @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  appointmentId String?             @unique // the booking made by claiming it

  // A person is offered a given slot at most once (so at most one offer SMS).
  @@unique([entryId, slotId])
  @@index([status, expiresAt])
}

// Waiting-room TV link for one doctor's "now serving" board (no login).
// The token is 256 random bits; only its SHA-256 (for lookup) and an
// AES-GCM-encrypted copy (so staff can view the link again) are stored.
// Regenerating revokes the old row and creates a new one.
// Hand-written partial unique index (migration *_display_links): one live
// (unrevoked) link per doctor.
model DisplayLink {
  id              String    @id @default(uuid())
  doctorId        String
  doctor          Doctor    @relation(fields: [doctorId], references: [id])
  tokenHash       String    @unique
  tokenEncrypted  String
  tokenPrefix     String // first 6 characters, for logs and the audit trail
  createdByUserId String
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([doctorId])
}
