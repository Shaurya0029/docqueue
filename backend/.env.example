DATABASE_URL=postgresql://docqueue:docqueue@localhost:5433/docqueue
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Payments
#   stub     = no gateway calls; "Pay" runs a locally signed webhook (dev and tests only,
#              refused when NODE_ENV=production)
#   razorpay = real Razorpay API. Use rzp_test_ keys for test mode (no money moves).
# A booking is confirmed only by Razorpay's signed webhook: in the Razorpay dashboard,
# add a webhook for the payment.captured event pointing at <public API URL>/payments/webhook
# with the same secret as RAZORPAY_WEBHOOK_SECRET. For local runs, expose the API with
# `cloudflared tunnel --url http://localhost:4000` and use the printed https URL.
PAYMENTS_MODE=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in razorpay mode and in production; stub mode falls back to a dev-only value.
RAZORPAY_WEBHOOK_SECRET=

# stub | live
SMS_MODE=stub
SMS_PROVIDER=
SMS_API_KEY=
