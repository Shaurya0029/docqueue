DATABASE_URL=postgresql://docqueue:docqueue@localhost:5433/docqueue
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Payments
#   stub     = no gateway calls; "Pay" runs a locally signed webhook (dev and tests only,
#              refused when NODE_ENV=production)
#   razorpay = real Razorpay API. Use rzp_test_ keys for test mode (no money moves).
# A booking is confirmed only by Razorpay's signed webhook: in the Razorpay dashboard,
# add a webhook for the payment.captured event pointing at <public API URL>/payments/webhook
# with the same secret as RAZORPAY_WEBHOOK_SECRET. For local runs, expose the API with
# `cloudflared tunnel --url http://localhost:4000` and use the printed https URL.
PAYMENTS_MODE=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in razorpay mode and in production; stub mode falls back to a dev-only value.
RAZORPAY_WEBHOOK_SECRET=

# SMS (OTPs and patient notifications)
#   stub = print messages to the API log; OTP is always 123456 (refused when NODE_ENV=production)
#   live = send through SMS_PROVIDER (not implemented yet: add a class in src/lib/sms/)
SMS_MODE=stub
SMS_PROVIDER=
SMS_API_KEY=

# Number of reverse proxies in front of the API (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0

# "Leave now" travel time
#   straight-line (default) = distance x 1.4 at 20 km/h, free, no key
#   osrm = driving time from an OSRM server at OSRM_URL (falls back to straight-line on failure)
TRAVEL_PROVIDER=straight-line
OSRM_URL=https://router.project-osrm.org
